# Cấu hình build CMS cho bản chạy thật (docker). Dùng bằng: vite build --mode deploy

# Không nhúng dữ liệu giả vào bản chạy thật
VITE_USE_MOCK = false

VITE_PUBLIC_PATH = /

# Đường dẫn TƯƠNG ĐỐI: nginx trong chính container CMS chuyển tiếp /basic-api sang backend.
# Nhờ vậy không phải nhúng tên miền vào bundle, đổi tên miền không phải build lại, và không dính CORS.
VITE_GLOB_API_URL = /basic-api

VITE_GLOB_UPLOAD_URL = /upload
VITE_GLOB_API_URL_PREFIX =

VITE_DROP_CONSOLE = true
VITE_BUILD_COMPRESS = 'none'
