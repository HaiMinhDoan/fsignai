# Chép thành .env rồi sửa:  cp .env.example .env
# KHÔNG commit tệp .env — nó chứa mật khẩu thật.

TZ=Asia/Ho_Chi_Minh

# Mạng dùng chung với nginx-proxy-manager
SHARED_NETWORK=slm_v2_app-network

# ---- PostgreSQL (đang chạy sẵn, không nằm trong docker compose này) ----
DB_URL=jdbc:postgresql://171.244.142.43:5432/fsign
DB_USERNAME=postgres
DB_PASSWORD=doi-mat-khau-o-day

# ---- Redis ----
REDIS_HOST=171.244.142.43
REDIS_PORT=6379
REDIS_PASSWORD=doi-mat-khau-o-day

# ---- MinIO ----
# Hai địa chỉ cho hai mục đích khác nhau, đừng gộp làm một:
#
#  • MINIO_ENDPOINT — SERVER dùng để tải tệp lên/xuống. Đi thẳng vào MinIO nên nhanh và không
#    dính giới hạn dung lượng của proxy (video ký hiệu có thể tới 500MB).
#  • MINIO_DOMAIN   — TRÌNH DUYỆT của bé dùng để xem video. Bắt buộc HTTPS khi trang chạy HTTPS,
#    nếu không trình duyệt chặn sạch video vì nội dung hỗn hợp. Để trống = dùng MINIO_ENDPOINT.
MINIO_ENDPOINT=http://171.244.142.43:9000
MINIO_DOMAIN=https://minio.slmglobal.vn
MINIO_ENDPOINT_UI=http://171.244.142.43:9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=doi-mat-khau-o-day
MINIO_BUCKET=fsignai

# ---- Kafka ----
KAFKA_SERVERS=171.244.142.43:29092

# ---- Service chấm điểm AI ----
# Bí mật dùng chung giữa backend và ai-service. Để trống = ai gọi cũng được (chỉ nên khi chạy máy cá nhân).
# Sinh một chuỗi ngẫu nhiên:  openssl rand -hex 32
AI_SERVICE_SECRET=
# Số video sinh mẫu song song. Mỗi luồng ăn ~1 lõi CPU khi chạy job hàng loạt.
AI_EXEMPLAR_JOB_WORKERS=4
AI_MAX_CONCURRENCY=4

# ---- Email (Spring gửi thông báo quan trọng) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sale@slmsolar.com
MAIL_PASSWORD=doi-app-password-o-day
